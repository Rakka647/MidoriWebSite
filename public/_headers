# Cache policy for Cloudflare Workers Static Assets (shipped inside dist/).
# GitHub Pages and nginx ignore this file, so existing deploys are unaffected.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=604800

/gallery/*
  Cache-Control: public, max-age=604800

/banner/*
  Cache-Control: public, max-age=604800

/qr/*
  Cache-Control: public, max-age=604800